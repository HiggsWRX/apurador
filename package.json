{
  "name": "apurador",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && npm run typecheck -w @apurador/site",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,astro,css}\"",
    "test": "vitest run",
    "build": "npm run build -w @apurador/site --",
    "dados": "npm run gerar -w @apurador/pipeline --",
    "noites": "npm run noites -w @apurador/pipeline --",
    "historico": "npm run historico -w @apurador/pipeline --",
    "cadastros": "npm run cadastros -w @apurador/pipeline --",
    "fotos": "npm run fotos -w @apurador/pipeline --",
    "tse-falso": "npm run tse-falso -w @apurador/ensaio --",
    "noite-local": "npm run noite-local -w @apurador/ensaio --",
    "coletor": "npm run coletor -w @apurador/coletor --",
    "noite": "npm run noite -w @apurador/coletor --",
    "conferir-entrega": "npm run conferir-entrega -w @apurador/coletor --",
    "replay": "vitest run packages/ensaio/test/replay.test.ts",
    "calibracao": "npm run calibracao -w @apurador/ensaio --",
    "conferir": "npm run conferir -w @apurador/pipeline --",
    "pesquisas": "npm run conferir-pesquisas -w @apurador/pipeline --",
    "deploy": "npm run deploy -w @apurador/site --"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-plugin-jsdoc": "^65.1.0",
    "fflate": "^0.8.3",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.5"
  }
}
