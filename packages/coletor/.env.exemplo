# As chaves de escrita do coletor no R2. Copie este arquivo para packages/coletor/.env (ignorado pelo Git) e cole os
# valores ali, nunca aqui. Cada chave é um token do R2 com "Object Read & Write" num bucket só, criado pelo dono em
# Cloudflare > R2 > Manage API tokens; o painel mostra o Access Key ID e o Secret Access Key uma vez só.
# As chaves do R2 só valem com --destino producao ou --destino ensaio; o tópico do ntfy, no fim, vale em todo destino.

# Bucket apurador-ao-vivo (a noite e o 24/10).
R2_PRODUCAO_ACCESS_KEY_ID=
R2_PRODUCAO_SECRET_ACCESS_KEY=

# Bucket apurador-ensaio (os ensaios gerais). Nunca a chave de produção.
R2_ENSAIO_ACCESS_KEY_ID=
R2_ENSAIO_SECRET_ACCESS_KEY=

# Os objetos da noite, num bucket sem endereço público por ambiente (packages/coletor/cloudflare/README.md, "Os objetos
# da noite"): apurador-noite na noite e no 24/10, apurador-ensaio-noite nos ensaios. Sem a chave, o coletor não grava o
# objeto da noite e só retoma do disco.
R2_NOITE_ACCESS_KEY_ID=
R2_NOITE_SECRET_ACCESS_KEY=
R2_ENSAIO_NOITE_ACCESS_KEY_ID=
R2_ENSAIO_NOITE_SECRET_ACCESS_KEY=

# Opcional: um token "Edit Cloudflare Workers" para republicar o Worker do plano B. Sem ele, vale o login do
# computador (npx wrangler login).
CLOUDFLARE_API_TOKEN=

# O tópico do ntfy dos alertas críticos (Operação na noite, decisão 8): um nome impossível de adivinhar, porque quem o sabe
# lê e publica nele. Gere com
#   node -e "console.log('apurador-' + crypto.randomUUID())"
# e assine o mesmo tópico no app do ntfy no celular. Sem ele, os alertas ficam só no computador. A sentinela tem a cópia
# dela, gravada com `npx wrangler secret put NTFY_TOPICO` (packages/coletor/cloudflare/README.md).
NTFY_TOPICO=
