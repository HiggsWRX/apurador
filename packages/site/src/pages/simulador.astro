---
import Simulador from "../components/Simulador";
import Base from "../layouts/Base.astro";
import { CHAVES } from "../lib/chaves";
import { ENDERECOS_DO_BUILD } from "../lib/enderecos-do-build";
import { SUBTITULO_DA_ELEICAO } from "../lib/ensaio";
import { BASE_PADRAO } from "../lib/projecao-antes-das-17h";
import { CAMINHO_DO_ARQUIVO, FINALISTAS_DO_SIMULADOR, SIMULADOR_ANTES_DAS_17H, VIES_DAS_HIPOTESES_PRONTAS } from "../lib/simulador-antes-das-17h";

// A tela própria do simulador "e se" (Simulador "e se", decisões 5 a 13), aberta pelo link da caixa da projeção. A ilha
// roda o `modelo` no navegador sobre o arquivo do build: antes das 17h, com a chave dele (e a da projeção) ligada, e aí
// o arquivo começa a vir junto com o HTML; desligada, a tela diz que ele abre às 17h. Às 17h, sem recarregar, passa ao
// arquivo do coletor, pelo leitor ao vivo, com os mesmos endereços das páginas de lugar. A prévia do link é a do site:
// o cabeçalho é o mesmo de toda página, sem imagem por simulação.
const titulo = 'Simulador "e se"';
---

<Base titulo={titulo}>
  {SIMULADOR_ANTES_DAS_17H && <link slot="head" rel="preload" href={CAMINHO_DO_ARQUIVO} as="fetch" crossorigin="anonymous" />}
  <div class="cabecalho">
    <nav class="trilha" aria-label="Onde você está">
      <ol>
        <li>
          <a href="/">Brasil</a>
          <span aria-hidden="true">›</span>
        </li>
        <li aria-current="page">{titulo}</li>
      </ol>
    </nav>
    <h1>{titulo}</h1>
    <p class="subtitulo">{SUBTITULO_DA_ELEICAO}</p>
  </div>
  <Simulador
    client:load
    arquivo={CAMINHO_DO_ARQUIVO}
    finalistas={FINALISTAS_DO_SIMULADOR}
    basePadrao={BASE_PADRAO}
    viesDoPrimeiroTurno={VIES_DAS_HIPOTESES_PRONTAS}
    noArAntesDas17h={SIMULADOR_ANTES_DAS_17H}
    enderecos={ENDERECOS_DO_BUILD}
    chaves={CHAVES.noite}
  />
  <noscript>
    <p class="cartao sim-aviso">O simulador roda no seu navegador e precisa de JavaScript.</p>
  </noscript>
</Base>
