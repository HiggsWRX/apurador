---
import "@fontsource-variable/inter";
import "@fontsource-variable/source-serif-4";
import "../estilos/global.css";
import BotaoDoTema from "../components/BotaoDoTema.astro";
import Busca from "../components/Busca.astro";
import Rodape from "../components/Rodape.astro";

interface Props {
  titulo: string;
}
const { titulo } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light dark" />
    <title>{titulo} · Apurador</title>
    <script is:inline>
      // Antes de pintar: o tema escolhido no botão (se houver) e a marca de que há JavaScript.
      document.documentElement.classList.add("js");
      try {
        const tema = localStorage.getItem("tema");
        if (tema === "claro" || tema === "escuro") document.documentElement.dataset.tema = tema;
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <header class="topo">
      <div class="topo-linha">
        <a class="marca" href="/">Apurador</a>
        <Busca />
        <BotaoDoTema />
      </div>
    </header>
    <main id="conteudo" class="pagina">
      <slot />
    </main>
    <Rodape />
  </body>
</html>
