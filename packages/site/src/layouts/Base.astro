---
import "@fontsource-variable/inter";
import "@fontsource-variable/source-serif-4";
import "../estilos/global.css";
import BotaoDoTema from "../components/BotaoDoTema.astro";
import Busca from "../components/Busca.astro";
import Rodape from "../components/Rodape.astro";
import { ENSAIO, TARJA_DO_ENSAIO } from "../lib/ensaio";
import { TOKEN_DO_WEB_ANALYTICS } from "../lib/projeto";

interface Props {
  titulo: string;
}
const { titulo } = Astro.props;
// No build do ensaio geral (Ensaio geral, decisão 5): `noindex` em toda página, também no `_headers` do Worker dele, a
// tarja dentro do topo, que fica sempre na tela e entra em qualquer print, e nenhuma visita contada na audiência do site.
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    {ENSAIO && <meta name="robots" content="noindex, nofollow" />}
    <title>{ENSAIO ? `Ensaio · ${titulo} · Apurador` : `${titulo} · Apurador`}</title>
    <script is:inline>
      // Antes de pintar: o tema escolhido no botão (se houver) e a marca de que há JavaScript.
      document.documentElement.classList.add("js");
      try {
        const tema = localStorage.getItem("tema");
        if (tema === "claro" || tema === "escuro") document.documentElement.dataset.tema = tema;
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="pular" href="#conteudo">
      Pular para o conteúdo
    </a>
    <header class="topo">
      {ENSAIO && (
        <p class="tarja-do-ensaio" role="note" data-bloco="tarja-do-ensaio">
          {TARJA_DO_ENSAIO}
        </p>
      )}
      <div class="topo-linha">
        <a class="marca" href="/">
          Apurador
        </a>
        <Busca />
        <BotaoDoTema />
      </div>
    </header>
    <main id="conteudo" class="pagina">
      <slot />
    </main>
    <Rodape />
    <!-- A audiência, no Cloudflare Web Analytics: sem cookies, e nenhum outro rastreador. -->
    {!ENSAIO && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: TOKEN_DO_WEB_ANALYTICS })}
      ></script>
    )}
  </body>
</html>
