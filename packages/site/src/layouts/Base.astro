---
interface Props {
  titulo: string;
}
const { titulo } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{titulo} · Apurador</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
    <footer>
      <p>Fonte: TSE, dados abertos de resultados (CC-BY).</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --texto: #1c1917;
    --texto-suave: #57534e;
    --fundo: #fafaf9;
    --barra: #a8a29e;
    --trilho: #e7e5e4;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --texto: #f5f5f4;
      --texto-suave: #a8a29e;
      --fundo: #1c1917;
      --barra: #78716c;
      --trilho: #292524;
    }
  }
  body {
    margin: 0;
    background: var(--fundo);
    color: var(--texto);
    font-family: system-ui, sans-serif;
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
  }
  main,
  footer {
    max-width: 40rem;
    margin: 0 auto;
    padding: 1rem;
  }
  footer {
    color: var(--texto-suave);
    font-size: 0.85rem;
  }
</style>
