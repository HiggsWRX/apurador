---
import { nomeCompleto, type Lugar } from "@apurador/pipeline";
import BlocoAoVivo from "../components/BlocoAoVivo";
import Historico from "../components/Historico.astro";
import NarracaoDaNoite from "../components/NarracaoDaNoite";
import Trilha from "../components/Trilha.astro";
import { CHAVES } from "../lib/chaves";
import { turnosDoLugar } from "../lib/curvas-passadas";
import { enderecosDoBuild } from "../lib/enderecos-ao-vivo";
import { FOTOS } from "../lib/fotos";
import { emLugar } from "../lib/lugares";
import { AGREGADO } from "../lib/pesquisas";
import Base from "./Base.astro";

// A casca de toda página de lugar (Telas da página de lugar, decisão 1). No celular, uma coluna:
// cabeçalho, o conteúdo principal, a narração e o histórico. No computador, a narração fica numa
// coluna fixa à direita da principal, e o histórico embaixo (o mapa, quando entrar, fica ao lado dele).
// O bloco ao vivo abre o conteúdo principal, e os blocos de antes das 17h vêm depois dele (o slot padrão).
// A narração é outra ilha, que desenha o quadro que a do bloco ao vivo lê.

interface Props {
  lugar: Lugar;
}
const { lugar } = Astro.props;
const nome = nomeCompleto(lugar);
// Os endereços dos arquivos ao vivo: no build, PUBLIC_AO_VIVO (o R2) e PUBLIC_AO_VIVO_PLANO_B (o Worker do plano B); no
// `astro dev`, as pastas que o coletor publica, servidas pela integração `ao-vivo-local`. Sem nenhum, a ilha não lê
// nada e fica no estado de antes das 17h.
const enderecos = enderecosDoBuild(
  import.meta.env.PUBLIC_AO_VIVO ?? (typeof __AO_VIVO_LOCAL__ === "string" ? __AO_VIVO_LOCAL__ : null),
  import.meta.env.PUBLIC_AO_VIVO_PLANO_B ?? (typeof __AO_VIVO_LOCAL_PLANO_B__ === "string" ? __AO_VIVO_LOCAL_PLANO_B__ : null),
);
---

<Base titulo={nome}>
  <div class="cabecalho">
    <Trilha lugar={lugar} />
    <h1>{nome}</h1>
    <p class="subtitulo">Eleição para Presidente · 2º turno em 25 de outubro de 2026</p>
  </div>
  <div class="colunas">
    <div class="principal">
      <BlocoAoVivo
        client:load
        id={lugar.id}
        tipo={lugar.tipo}
        uf={lugar.uf}
        em={emLugar(lugar)}
        fotos={FOTOS}
        enderecos={enderecos}
        chaves={CHAVES.noite}
        turnosPassados={turnosDoLugar(lugar.id)}
        pesquisasDoAgregado={CHAVES.antesDas17h.agregado && AGREGADO ? AGREGADO.pesquisas.length : null}
      />
      <slot />
    </div>
    <NarracaoDaNoite client:load id={lugar.id} chaves={CHAVES.noite} />
  </div>
  <div class="abaixo">
    <Historico lugar={lugar} />
  </div>
</Base>
