---
import { BASE_NOS_ARQUIVOS, NOME_DA_BASE, type IdDaBase } from "../lib/bases-da-projecao";
import { formatarPctComCasas } from "../lib/formato";
import { graficoDaNoite } from "../lib/graficos-da-metodologia";
import type { NoiteReproduzida } from "../lib/metodologia";

// Os gráficos de uma noite: o placar parcial, a projeção de uma base com a faixa de 95% e o resultado, de 0% a 100%
// das seções, um por botão. Na seção "Como o modelo teria se saído" da metodologia (Página de metodologia, decisões 2
// e 3), as noites reproduzidas, com os botões "2022 | 2018" e a base que a caixa da projeção abre na noite; em "Como a
// projeção se saiu", na página do Brasil, a noite de 25/10 publicada, com um botão por base. Sem JavaScript, os botões
// somem e os gráficos ficam à vista, um embaixo do outro, como no histórico da página de lugar.

/** Um gráfico, com o botão que o abre. */
interface Grafico {
  /** O id do gráfico na página: "2022", "com-pesquisas". */
  id: string;
  botao: string;
  noite: NoiteReproduzida;
  base: IdDaBase;
  /** O título sobre o gráfico: "2º turno de 2022, Lula × Bolsonaro". */
  titulo: string;
  /** O começo da descrição para o leitor de tela: "Noite do 2º turno de 2022 reproduzida". */
  assunto: string;
}

interface Props {
  /** Os gráficos, na ordem dos botões: com um só, não há botões. */
  graficos: Grafico[];
  /** O id do gráfico que abre aberto; de partida, o do primeiro. */
  aberto?: string;
  /** O que os botões escolhem, para o leitor de tela: "Noite", "Base". */
  escolha: string;
}
const { graficos: pedidos, aberto = pedidos[0]!.id, escolha } = Astro.props;
const LARGURA = 340;
const ALTURA = 220;
const pct = (n: number) => formatarPctComCasas(n, 1);
const graficos = pedidos.map(({ id, botao, noite, base, titulo, assunto }) => {
  const g = graficoDaNoite(noite, { largura: LARGURA, altura: ALTURA }, base);
  const [primeiro] = noite.finalistas;
  const placares = noite.momentos.filter((m) => m.placar !== null);
  const projecoes = noite.momentos.map((m) => m[BASE_NOS_ARQUIVOS[base]].projecao);
  const resultado = `${primeiro.nome} ${formatarPctComCasas(noite.resultado, 2)}`;
  const descricao =
    `${assunto}, de 0% a 100% das seções totalizadas, em % de ${primeiro.nome}: ` +
    `o placar parcial, de ${pct(placares[0]!.placar!)} com a primeira seção a ${pct(placares[placares.length - 1]!.placar!)} no fim; ` +
    `a projeção na base ${NOME_DA_BASE[base]}, com a faixa de 95%, de ${pct(projecoes[0]!)} antes da primeira seção ` +
    `a ${pct(projecoes[projecoes.length - 1]!)} no fim; e o resultado, ${resultado}.`;
  return { id, botao, g, titulo, resultado, descricao };
});
// A legenda diz a base quando todos os gráficos são da mesma; senão, cada título diz a dele.
const bases = [...new Set(pedidos.map((p) => p.base))];
const projecao = bases.length === 1 ? `Projeção, ${NOME_DA_BASE[bases[0]!]}` : "Projeção";
---

<div class="graficos-da-noite" data-graficos-da-noite>
  {graficos.length > 1 && (
    <div class="turnos" role="group" aria-label={escolha}>
      {graficos.map(({ id, botao }) => (
        <button type="button" data-grafico-botao={id} aria-controls={`grafico-${id}`} aria-pressed={id === aberto ? "true" : "false"}>
          {botao}
        </button>
      ))}
    </div>
  )}
  {graficos.map(({ id, g, titulo, resultado, descricao }) => (
    <div class="grafico" id={`grafico-${id}`} data-grafico={id} data-ativo={id === aberto ? "" : undefined}>
      <p class="titulo-da-noite">{titulo}</p>
      <svg viewBox={`0 0 ${LARGURA} ${ALTURA}`} role="img" aria-label={descricao}>
        {g.marcasY.map((m) => (
          <>
            <line class={m.valor === 50 ? "grade meio" : "grade"} x1={g.area.esquerda} x2={g.area.direita} y1={m.posicao} y2={m.posicao} />
            <text class="eixo" x={g.area.esquerda - 6} y={m.posicao + 3.5} text-anchor="end">
              {m.rotulo}
            </text>
          </>
        ))}
        {g.marcasX.map((m) => (
          <text class="eixo" x={m.posicao} y={g.area.base + 14} text-anchor="middle">
            {m.rotulo}
          </text>
        ))}
        <text class="eixo" x={(g.area.esquerda + g.area.direita) / 2} y={ALTURA - 2} text-anchor="middle">
          % de seções totalizadas
        </text>
        <path class="faixa" d={g.faixa} />
        <line class="resultado" x1={g.area.esquerda} x2={g.area.direita} y1={g.yResultado} y2={g.yResultado} />
        <path class="linha-da-projecao" d={g.projecao} />
        <path class="placar" d={g.placar} />
        <text class="rotulo-do-resultado" x={g.area.direita} y={g.rotuloAbaixo ? g.yResultado + 13 : g.yResultado - 5} text-anchor="end">
          resultado: {resultado}
        </text>
      </svg>
    </div>
  ))}
  <p class="legenda">
    <span class="placar">Placar parcial</span>
    <span class="linha-da-projecao">{projecao}</span>
    <span class="faixa">faixa de 95%</span>
    <span class="resultado">resultado</span>
  </p>
</div>

<script>
  for (const bloco of document.querySelectorAll("[data-graficos-da-noite]")) {
    const botoes = [...bloco.querySelectorAll<HTMLButtonElement>("[data-grafico-botao]")];
    for (const botao of botoes) {
      botao.addEventListener("click", () => {
        for (const outro of botoes) {
          const ativo = outro === botao;
          outro.setAttribute("aria-pressed", String(ativo));
          bloco.querySelector(`[data-grafico="${outro.dataset.graficoBotao}"]`)?.toggleAttribute("data-ativo", ativo);
        }
      });
    }
  }
</script>

<style>
  :global(:root.js) .grafico:not([data-ativo]) {
    display: none;
  }
  .grafico + .grafico {
    margin-top: 1rem;
  }
  .titulo-da-noite {
    margin: 0 0 0.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  svg {
    display: block;
    width: 100%;
    max-width: 30rem;
    height: auto;
    overflow: visible;
  }
  .grade {
    stroke: var(--borda);
    stroke-width: 1;
  }
  .grade.meio {
    stroke: var(--borda-forte);
    stroke-width: 1.5;
  }
  .eixo {
    fill: var(--texto-suave);
    font-size: 10px;
  }
  path.faixa {
    fill: var(--grafite);
    opacity: 0.16;
  }
  path.linha-da-projecao {
    fill: none;
    stroke: var(--grafite);
    stroke-width: 2;
    stroke-dasharray: 7 4;
  }
  path.placar {
    fill: none;
    stroke: var(--texto);
    stroke-width: 2;
  }
  line.resultado {
    stroke: var(--texto-suave);
    stroke-width: 1.5;
    stroke-dasharray: 1 3;
  }
  .rotulo-do-resultado {
    fill: var(--texto-suave);
    font-size: 10.5px;
    font-weight: 600;
  }
  .legenda {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.875rem;
    margin: 0.375rem 0 0;
    font-size: 0.8125rem;
    color: var(--texto-suave);
  }
  .legenda span::before {
    content: "";
    display: inline-block;
    width: 1.125rem;
    margin-right: 0.3125rem;
    vertical-align: middle;
    border-top: 2px solid var(--texto);
  }
  .legenda .linha-da-projecao::before {
    border-top: 2px dashed var(--grafite);
  }
  .legenda .faixa::before {
    height: 0.5rem;
    border: none;
    background: var(--grafite);
    opacity: 0.16;
  }
  .legenda .resultado::before {
    border-top: 2px dotted var(--texto-suave);
  }
</style>
