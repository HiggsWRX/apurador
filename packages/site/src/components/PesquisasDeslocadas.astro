---
import { NOME_DA_BASE } from "../lib/bases-da-projecao";
import { graficoDoErro } from "../lib/graficos-da-metodologia";
import { corDoPartido } from "../lib/identidade";
import type { NoiteReproduzida } from "../lib/metodologia";

// O erro da projeção no começo da noite com as pesquisas deslocadas (Página de metodologia, decisão 2, gráfico extra;
// Combinação de pesquisas e apuração, decisão 4): o erro, em pontos, das duas bases e do agregado deslocado 2 pontos
// para cada finalista, até 30% das seções. Acima de zero, o erro é a favor do 1º finalista da noite.

interface Props {
  noite: NoiteReproduzida;
}
const { noite } = Astro.props;
const LARGURA = 340;
const ALTURA = 210;
const g = graficoDoErro(noite, { largura: LARGURA, altura: ALTURA });
const [primeiro, segundo] = noite.finalistas;
const descricao =
  `Erro da projeção na noite do 2º turno de ${noite.ano} reproduzida, em pontos, de 0% a 30% das seções totalizadas: ` +
  `nas bases ${NOME_DA_BASE["so-apuracao"]} e ${NOME_DA_BASE["com-pesquisas"]} e com o agregado de pesquisas deslocado 2 pontos ` +
  `para ${primeiro.nome} e para ${segundo.nome}. Acima de zero, o erro é a favor de ${primeiro.nome}.`;
---

<svg class="deslocadas" viewBox={`0 0 ${LARGURA} ${ALTURA}`} role="img" aria-label={descricao}>
  {g.marcasY.map((m) => (
    <>
      <line class={m.valor === 0 ? "grade zero" : "grade"} x1={g.area.esquerda} x2={g.area.direita} y1={m.posicao} y2={m.posicao} />
      <text class="eixo" x={g.area.esquerda - 5} y={m.posicao + 3.5} text-anchor="end">
        {m.rotulo}
      </text>
    </>
  ))}
  {g.marcasX.map((m) => (
    <text class="eixo" x={m.posicao} y={g.area.base + 14} text-anchor="middle">
      {m.rotulo}
    </text>
  ))}
  <text class="eixo" x={(g.area.esquerda + g.area.direita) / 2} y={ALTURA - 2} text-anchor="middle">
    % de seções totalizadas
  </text>
  <text class="eixo" x={g.area.esquerda + 4} y={g.area.topo + 10}>
    acima: erro a favor de {primeiro.nome}
  </text>
  <text class="eixo" x={g.area.esquerda + 4} y={g.area.base - 4}>
    abaixo: a favor de {segundo.nome}
  </text>
  <path class="deslocada" data-cor={corDoPartido(primeiro.partido)} d={g.deslocadas[0]} />
  <path class="deslocada" data-cor={corDoPartido(segundo.partido)} d={g.deslocadas[1]} />
  <path class="com-pesquisas" d={g.comPesquisas} />
  <path class="so-apuracao" d={g.soApuracao} />
</svg>
<p class="legenda">
  <span class="so-apuracao">{NOME_DA_BASE["so-apuracao"]}</span>
  <span class="com-pesquisas">{NOME_DA_BASE["com-pesquisas"]}, pesquisas reais</span>
  <span class="deslocada" data-cor={corDoPartido(primeiro.partido)}>
    pesquisas +2 para {primeiro.nome}
  </span>
  <span class="deslocada" data-cor={corDoPartido(segundo.partido)}>
    pesquisas +2 para {segundo.nome}
  </span>
</p>

<style>
  .deslocadas {
    display: block;
    width: 100%;
    max-width: 30rem;
    height: auto;
    overflow: visible;
  }
  .grade {
    stroke: var(--borda);
    stroke-width: 1;
  }
  .grade.zero {
    stroke: var(--borda-forte);
    stroke-width: 1.5;
  }
  .eixo {
    fill: var(--texto-suave);
    font-size: 10px;
  }
  path {
    fill: none;
    stroke-width: 1.8;
  }
  path.so-apuracao {
    stroke: var(--grafite);
    stroke-width: 2.2;
  }
  path.com-pesquisas {
    stroke: var(--texto-suave);
    stroke-dasharray: 6 3;
  }
  path.deslocada {
    stroke-dasharray: 2 3;
  }
  path[data-cor="flavio"] {
    stroke: var(--cor-flavio);
  }
  path[data-cor="lula"] {
    stroke: var(--cor-lula);
  }
  path[data-cor="cinza"] {
    stroke: var(--cor-cinza);
  }
  .legenda {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.875rem;
    margin: 0.375rem 0 0;
    font-size: 0.8125rem;
    color: var(--texto-suave);
  }
  .legenda span::before {
    content: "";
    display: inline-block;
    width: 1.125rem;
    margin-right: 0.3125rem;
    vertical-align: middle;
    border-top: 2px solid var(--grafite);
  }
  .legenda .com-pesquisas::before {
    border-top: 2px dashed var(--texto-suave);
  }
  .legenda .deslocada::before {
    border-top-style: dotted;
  }
  .legenda [data-cor="flavio"]::before {
    border-top-color: var(--cor-flavio);
  }
  .legenda [data-cor="lula"]::before {
    border-top-color: var(--cor-lula);
  }
</style>
