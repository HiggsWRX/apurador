---
import { turnosDoLugar } from "../lib/curvas-passadas";
import { corDoPartido } from "../lib/identidade";
import { FINALISTAS } from "../lib/pesquisas";
import { BASE_PADRAO, METADE_DAS_SECOES, ORDEM_DE_CHEGADA, PROJECAO_ANTES_DAS_17H } from "../lib/projecao-antes-das-17h";
import { CurvaProjetada } from "./CurvaProjetada";
import NoitesPassadas from "./NoitesPassadas";

// "O que esperar da noite" (Telas da página de lugar, decisão 11; Combinação de pesquisas e apuração, decisão 6): a
// ordem de chegada típica, medida no 1º turno de 2026, e a curva projetada de 0% a 100% das seções em cada base da
// projeção, com a virada projetada. Antes da primeira seção ninguém está atrás no placar parcial, então não há rótulo
// do sinal de virada, e nenhuma frase diz quem vence ou quando vira. Com a chave da projeção desligada, fica o texto
// da ordem de chegada e, sem número de projeção, as curvas reais de noites passadas (Consulta a advogado eleitoral,
// decisão 2). A base desenhada é a escolhida no controle da projeção, logo abaixo.

const [primeiro, segundo] = FINALISTAS.map((c) => ({ nomeUrna: c.nomeUrna, cor: corDoPartido(c.partido) }));
const pct = (fracao: number) => `${Math.round(100 * fracao)}%`;
const [cedo, ...resto] = ORDEM_DE_CHEGADA;
const chegada =
  cedo && resto.length > 0
    ? `No 1º turno de 2026, quando o Brasil tinha ${METADE_DAS_SECOES}% das seções totalizadas, o ${cedo.regiao} já tinha ${pct(cedo.fracao)} das suas; ` +
      resto.map((r, i) => `${i === resto.length - 1 ? "e " : ""}o ${r.regiao}, ${pct(r.fracao)}`).join("; ") +
      "."
    : "";
---

<section class="cartao esperar" data-bloco="o-que-esperar-da-noite" aria-labelledby="esperar-titulo">
  <h2 id="esperar-titulo">O que esperar da noite</h2>
  <p>
    As seções não chegam na mesma ordem em todo o país, e o placar parcial do começo da noite é o dos lugares que chegam cedo. {chegada}
  </p>
  {
    PROJECAO_ANTES_DAS_17H && (
      <>
        {PROJECAO_ANTES_DAS_17H.bases.map((base) => (
          <div data-base={base.id} data-ativa={base.id === BASE_PADRAO ? "" : undefined}>
            <h3 class="base-titulo">Base da projeção: {base.nome}</h3>
            <CurvaProjetada id={base.id} base={base.nome} primeiro={primeiro!} segundo={segundo!} curva={base.curva} />
          </div>
        ))}
        <p class="nota">A curva projetada supõe, em 25/10, a ordem de chegada do 1º turno de 2026, e parte da projeção de cada base, que se escolhe abaixo.</p>
      </>
    )
  }
  {!PROJECAO_ANTES_DAS_17H && <NoitesPassadas client:visible turnos={turnosDoLugar("BR")} />}
  <p class="fonte">Cálculo do Apurador com dados do TSE</p>
</section>

<style>
  p {
    margin: 0.5rem 0 0;
  }
</style>
