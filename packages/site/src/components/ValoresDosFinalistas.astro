---
import { formatarCalculo } from "../lib/formato";
import { corDoPartido } from "../lib/identidade";
import type { PctDoCandidato } from "../lib/pesquisas";

// O par de números de um cálculo do Apurador, um por finalista, na cor de cada um e com uma casa, e, numa projeção,
// ± a margem de 95%.

interface Props {
  valores: PctDoCandidato[];
  /** A margem de 95% da projeção, em pontos: "± 3,5" ao lado de cada número. */
  margem?: number;
}
const { valores, margem } = Astro.props;
---

<p class="valores">
  {valores.map((c) => (
    <span data-cor={corDoPartido(c.candidato.partido)}>
      {c.candidato.nomeUrna} <strong>{formatarCalculo(c.pct)}%</strong>
      {margem !== undefined && <small class="margem">± {formatarCalculo(margem)}</small>}
    </span>
  ))}
</p>

<style>
  .valores {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0.5rem 0;
  }
  strong {
    font-size: 1.5rem;
  }
  [data-cor="flavio"] strong {
    color: var(--cor-flavio);
  }
  [data-cor="lula"] strong {
    color: var(--cor-lula);
  }
  .margem {
    margin-left: 0.25rem;
    color: var(--texto-suave);
    font-size: 0.875rem;
  }
</style>
