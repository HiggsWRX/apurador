---
import { NOME_DA_BASE } from "../lib/bases-da-projecao";
import { formatarCalculo, formatarPctComCasas } from "../lib/formato";
import { graficoDaNoite } from "../lib/graficos-da-metodologia";
import type { NoiteReproduzida } from "../lib/metodologia";

// A noite reproduzida da seção "Como o modelo teria se saído" (Página de metodologia, decisões 2 e 3): o placar
// parcial, a projeção com a faixa de 95% e o resultado, de 0% a 100% das seções, com os botões "2022 | 2018". A
// projeção é a da base que a caixa da projeção abre na noite, Apuração + pesquisas. Sem JavaScript, os botões somem e
// as duas noites ficam à vista, uma embaixo da outra, como no histórico da página de lugar.

interface Props {
  noites: NoiteReproduzida[];
}
const { noites } = Astro.props;
const LARGURA = 340;
const ALTURA = 220;
const pct = (n: number) => `${formatarCalculo(n)}%`;
const graficos = noites.map((noite) => {
  const g = graficoDaNoite(noite, (m) => m.comPesquisas, { largura: LARGURA, altura: ALTURA });
  const [primeiro, segundo] = noite.finalistas;
  const placares = noite.momentos.filter((m) => m.placar !== null);
  const resultado = `${primeiro.nome} ${formatarPctComCasas(noite.resultado, 2)}`;
  const descricao =
    `Noite do 2º turno de ${noite.ano} reproduzida, de 0% a 100% das seções totalizadas, em % de ${primeiro.nome}: ` +
    `o placar parcial, de ${pct(placares[0]!.placar!)} com a primeira seção a ${pct(placares[placares.length - 1]!.placar!)} no fim; ` +
    `a projeção na base ${NOME_DA_BASE["com-pesquisas"]}, com a faixa de 95%, de ${pct(noite.agregado)} antes da primeira seção ` +
    `a ${pct(noite.momentos[noite.momentos.length - 1]!.comPesquisas.projecao)} no fim; e o resultado, ${resultado}.`;
  return { noite, g, titulo: `2º turno de ${noite.ano}, ${primeiro.nome} × ${segundo.nome}`, resultado, descricao };
});
---

<div class="noites-reproduzidas" data-noites-reproduzidas>
  <div class="turnos" role="group" aria-label="Noite">
    {graficos.map(({ noite }, i) => (
      <button type="button" data-noite-botao={noite.ano} aria-controls={`noite-${noite.ano}`} aria-pressed={i === 0 ? "true" : "false"}>
        {noite.ano}
      </button>
    ))}
  </div>
  {graficos.map(({ noite, g, titulo, resultado, descricao }, i) => (
    <div class="noite" id={`noite-${noite.ano}`} data-noite={noite.ano} data-ativo={i === 0 ? "" : undefined}>
      <p class="titulo-da-noite">{titulo}</p>
      <svg viewBox={`0 0 ${LARGURA} ${ALTURA}`} role="img" aria-label={descricao}>
        {g.marcasY.map((m) => (
          <>
            <line class={m.valor === 50 ? "grade meio" : "grade"} x1={g.area.esquerda} x2={g.area.direita} y1={m.posicao} y2={m.posicao} />
            <text class="eixo" x={g.area.esquerda - 6} y={m.posicao + 3.5} text-anchor="end">
              {m.rotulo}
            </text>
          </>
        ))}
        {g.marcasX.map((m) => (
          <text class="eixo" x={m.posicao} y={g.area.base + 14} text-anchor="middle">
            {m.rotulo}
          </text>
        ))}
        <text class="eixo" x={(g.area.esquerda + g.area.direita) / 2} y={ALTURA - 2} text-anchor="middle">
          % de seções totalizadas
        </text>
        <path class="faixa" d={g.faixa} />
        <line class="resultado" x1={g.area.esquerda} x2={g.area.direita} y1={g.yResultado} y2={g.yResultado} />
        <path class="linha-da-projecao" d={g.projecao} />
        <path class="placar" d={g.placar} />
        <text class="rotulo-do-resultado" x={g.area.direita} y={g.yResultado - 5} text-anchor="end">
          resultado: {resultado}
        </text>
      </svg>
    </div>
  ))}
  <p class="legenda">
    <span class="placar">Placar parcial</span>
    <span class="linha-da-projecao">Projeção, {NOME_DA_BASE["com-pesquisas"]}</span>
    <span class="faixa">faixa de 95%</span>
    <span class="resultado">resultado</span>
  </p>
</div>

<script>
  for (const bloco of document.querySelectorAll("[data-noites-reproduzidas]")) {
    const botoes = [...bloco.querySelectorAll<HTMLButtonElement>("[data-noite-botao]")];
    for (const botao of botoes) {
      botao.addEventListener("click", () => {
        for (const outro of botoes) {
          const ativo = outro === botao;
          outro.setAttribute("aria-pressed", String(ativo));
          bloco.querySelector(`[data-noite="${outro.dataset.noiteBotao}"]`)?.toggleAttribute("data-ativo", ativo);
        }
      });
    }
  }
</script>

<style>
  :global(:root.js) .noite:not([data-ativo]) {
    display: none;
  }
  .noite + .noite {
    margin-top: 1rem;
  }
  .titulo-da-noite {
    margin: 0 0 0.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  svg {
    display: block;
    width: 100%;
    max-width: 30rem;
    height: auto;
    overflow: visible;
  }
  .grade {
    stroke: var(--borda);
    stroke-width: 1;
  }
  .grade.meio {
    stroke: var(--borda-forte);
    stroke-width: 1.5;
  }
  .eixo {
    fill: var(--texto-suave);
    font-size: 10px;
  }
  path.faixa {
    fill: var(--grafite);
    opacity: 0.16;
  }
  path.linha-da-projecao {
    fill: none;
    stroke: var(--grafite);
    stroke-width: 2;
    stroke-dasharray: 7 4;
  }
  path.placar {
    fill: none;
    stroke: var(--texto);
    stroke-width: 2;
  }
  line.resultado {
    stroke: var(--texto-suave);
    stroke-width: 1.5;
    stroke-dasharray: 1 3;
  }
  .rotulo-do-resultado {
    fill: var(--texto-suave);
    font-size: 10.5px;
    font-weight: 600;
  }
  .legenda {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.875rem;
    margin: 0.375rem 0 0;
    font-size: 0.8125rem;
    color: var(--texto-suave);
  }
  .legenda span::before {
    content: "";
    display: inline-block;
    width: 1.125rem;
    margin-right: 0.3125rem;
    vertical-align: middle;
    border-top: 2px solid var(--texto);
  }
  .legenda .linha-da-projecao::before {
    border-top: 2px dashed var(--grafite);
  }
  .legenda .faixa::before {
    height: 0.5rem;
    border: none;
    background: var(--grafite);
    opacity: 0.16;
  }
  .legenda .resultado::before {
    border-top: 2px dotted var(--texto-suave);
  }
</style>
